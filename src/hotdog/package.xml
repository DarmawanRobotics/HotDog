<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>hotdog</name>
  <version>0.1.0</version>
  <description>Bringup of HotDog on the Lynx M20: the robot profile, the M20 driver settings, the per-node overrides of the Dharma stack, one launch for the whole robot (and the same stack on the simulator).</description>
  <maintainer email="darmawandeveloper@gmail.com">Agus Darmawan</maintainer>
  <license>Apache-2.0</license>

  <exec_depend>dharma_utils</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>dharma_interfaces</exec_depend>
  <exec_depend>hotdog_interfaces</exec_depend>
  <exec_depend>dharma_odometry</exec_depend>
  <exec_depend>dharma_localization</exec_depend>
  <exec_depend>dharma_perception</exec_depend>
  <exec_depend>dharma_mapping</exec_depend>
  <exec_depend>dharma_navigation</exec_depend>
  <exec_depend>dharma_control</exec_depend>
  <exec_depend>dharma_health</exec_depend>
  <exec_depend>dharma_sim</exec_depend>
  <exec_depend>hotdog_base</exec_depend>
  <exec_depend>m20_bringup</exec_depend>
  <exec_depend>hotdog_inspection</exec_depend>
  <exec_depend>hotdog_patrol</exec_depend>
  <exec_depend>hotdog_reports</exec_depend>
  <exec_depend>hotdog_alerts</exec_depend>
  <exec_depend>unipod_driver</exec_depend>

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
