<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>hotdog_patrol</name>
  <version>0.1.0</version>
  <description>Route patrols of HotDog: start from the dock (checks, re-anchoring, stand-up, route, follower), on demand or at fixed times, the patrol summary of the inspections, back to the dock.</description>
  <maintainer email="darmawandeveloper@gmail.com">Agus Darmawan</maintainer>
  <license>Apache-2.0</license>

  <exec_depend>dharma_utils</exec_depend>
  <exec_depend>dharma_interfaces</exec_depend>
  <exec_depend>hotdog_base</exec_depend>
  <exec_depend>hotdog_interfaces</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>std_srvs</exec_depend>
  <exec_depend condition="$ROS_DISTRO != foxy">tf2_ros_py</exec_depend>
  <exec_depend condition="$ROS_DISTRO == foxy">tf2_ros</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <test_depend>geometry_msgs</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
